{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
VARIANT PICKER
----------------------------------------------------------------------------------------------------------------------

Render the variant picker option selectors.

********************************************
Supported variables

* product: the product to render
* context: can be "main_product", "featured_product" or "quick_buy"
* form_id: the ID of the form
* hide_sold_out_variants: if true, hides unavailable variants
* separate_options: if true, adds <hr> between option sets
* selector_style, swatch_selector_style, block_selector_style, swatch_selector_size
* variant_image_options: comma-list of option names for variant-image mode
* size_chart_page: the page object for your "Size chart" content
* alignment: "start", "center", or "end"
{%- endcomment -%}

{%- liquid
  assign color_label_list      = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ','
  assign size_label_list       = 'general.label.size'  | t | replace: ', ', ',' | downcase | split: ','
  assign variant_image_options = variant_image_options    | replace: ', ', ',' | downcase | split: ','

  if context == 'main_product'
    assign is_main_product = true
  endif
-%}

{%- unless product.has_only_default_variant -%}
  <variant-picker
    class="variant-picker"
    section-id="{{ section.id }}"
    form-id="{{ form_id }}"
    handle="{{ product.handle }}"
    {% if is_main_product %}update-url{% endif %}
  >
    {%- comment -%}
      Output JSON for JS variant updates
    {%- endcomment -%}
    <script data-variant type="application/json">
      {{- product.selected_or_first_available_variant | json -}}
    </script>

    {%- for option in product.options_with_values -%}
      {% liquid
        assign option_downcase                = option.name  | downcase
        assign resolved_option_selector_style = selector_style
        assign swatch_count                   = option.values | map: 'swatch' | compact | size

        if swatch_count > 0 and swatch_selector_style != 'none'
          assign resolved_option_selector_style = swatch_selector_style
        endif

        if swatch_count == 0 and color_label_list contains option_downcase and swatch_selector_style != 'none'
          assign resolved_option_selector_style = swatch_selector_style
        endif

        if variant_image_options contains option_downcase
          assign resolved_option_selector_style = 'variant_image'
        endif
      %}

      <fieldset class="variant-picker__option justify-{{ alignment }}">
        <div class="variant-picker__option-info {% if alignment == 'start' %}justify-between{% else %}justify-{{ alignment }}{% endif %}">

          {%- if size_chart_page != blank and size_label_list contains option_downcase -%}
            {%- capture id -%}size-chart-{{ section.id }}-{{ block.id }}{%- endcapture -%}
            <button
              type="button"
              class="link subheading"
              aria-controls="{{ id | escape }}"
              aria-expanded="false"
            >
              {{ 'product.general.size_chart' | t }}
            </button>
            <x-drawer
              id="{{ id | escape }}"
              class="drawer color-scheme color-scheme--{{ settings.default_color_scheme.id }}"
            >
              <span class="h5" slot="header">{{ size_chart_page.title }}</span>

              {%- if template.suffix == 'reworks' -%}
                {%- render 'size-chart-rework' -%}
              {%- else -%}
                {{- size_chart_page.url | json -}}
                <div
                  class="size-chart-drawer-content"
                  data-size-chart-url="{{ size_chart_page.url }}"
                  data-loaded="false"
                >
                  <div class="size-chart-drawer-loading">Loading…</div>
                </div>
              {%- endif -%}

            </x-drawer>
          {%- endif -%}
        </div>

        {%- if resolved_option_selector_style == 'dropdown' -%}
          <div class="relative">
            {%- capture popover_id -%}popover-variant-dropdown-{{ section.id }}-{{ product.id }}-{{ option.position }}{%- endcapture -%}
            <button
              type="button"
              class="select {% if settings.input_uppercase %}subheading{% endif %}"
              aria-controls="{{ popover_id }}"
              aria-expanded="false"
            >
              <span id="{{ popover_id }}-selected-value">{{- option.selected_value -}}</span>
              {%- render 'icon' with 'chevron-down' -%}
            </button>

            <x-popover
              id="{{ popover_id }}"
              class="popover popover--w-full color-scheme color-scheme--{{ settings.default_color_scheme.id }}"
              close-on-listbox-change
            >
              <p class="h6" slot="header">{{ option.name }}</p>
              <div class="popover__value-list">
                {%- assign param_name = form_id | append: '-option' | append: option.position -%}
                {%- for option_value in option.values -%}
                  {%- capture option_markup -%}
                    <span {% unless option_value.available %}class="line-through"{% endunless %}>{{ option_value }}</span>
                  {%- endcapture -%}

                  {%- if hide_sold_out_variants == false or option_value.available or option_value.selected -%}
                    {%- if is_main_product and option_value.product_url -%}
                      <div class="popover__value-option">
                        {%- if option_value.selected -%}
                          <input
                            class="sr-only"
                            type="radio"
                            id="{{ param_name }}-{{ option_value.id }}"
                            form="{{ form_id }}"
                            name="{{ param_name }}"
                            data-option-position="{{ option.position }}"
                            value="{{ option_value.id }}"
                            checked
                          >
                        {%- endif -%}
                        <a
                          href="{{ option_value.variant.url | default: option_value.product_url }}"
                          class="h-stack justify-between gap-2 link-faded-reverse"
                        >
                          {{ option_markup }}
                        </a>
                      </div>
                    {%- else -%}
                      <label class="popover__value-option" for="{{ param_name }}-{{ option_value.id }}">
                        <input
                          class="sr-only"
                          type="radio"
                          id="{{ param_name }}-{{ option_value.id }}"
                          form="{{ form_id }}"
                          name="{{ param_name }}"
                          {% if option_value.product_url %}data-product-url="{{ option_value.product_url }}"{% endif %}
                          data-option-position="{{ option.position }}"
                          value="{{ option_value.id }}"
                          {% if option_value.selected %}checked{% endif %}
                        >
                        {{ option_markup }}
                      </label>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </x-popover>
          </div>
        {%- else -%}
          {% case resolved_option_selector_style %}
            {% when 'swatch' %}
              {% case settings.color_swatch_shape %}
                {% when 'circle' %}
                  {% if swatch_selector_size == 'sm' %}
                    {% assign list_classes = 'h-stack gap-3 wrap' %}
                  {% else %}
                    {% assign list_classes = 'h-stack gap-4 wrap' %}
                  {% endif %}
                {% else %}
                  {% if swatch_selector_size == 'sm' %}
                    {% assign list_classes = 'h-stack gap-3 wrap' %}
                  {% else %}
                    {% assign list_classes = 'h-stack gap-4 wrap' %}
                  {% endif %}
              {% endcase %}
            {% when 'variant_image' %}
              {% assign list_classes = 'h-stack gap-1 wrap' %}
            {% else %}
              {% assign list_classes = 'h-stack gap-3 wrap' %}
          {% endcase %}

          <div class="variant-picker__option-values {{ list_classes }}">
            {%- assign input_name = form_id | append: '-option' | append: option.position -%}
            {%- for option_value in option.values -%}
              {% render 'option-value',
                  type:            resolved_option_selector_style,
                  form:            form_id,
                  option_value:    option_value,
                  param_name:      input_name,
                  option_position: option.position,
                  size:            swatch_selector_size,
                  style:           block_selector_style,
                  hide_if_disabled: hide_sold_out_variants,
                  reload_page_for_combined_products: is_main_product,
                  id_prefix: forloop.index %}
            {%- endfor -%}
          </div>
        {%- endif -%}

      </fieldset>

      {%- if separate_options and forloop.last == false -%}
        <hr>
      {%- endif -%}
    {%- endfor -%}
  </variant-picker>
{%- endunless -%}

<style>
  .size-chart-drawer-loading {
    padding: 2rem;
    text-align: center;
    color: #999;
    font-size: 13px;
  }
</style>

<script>
  (function () {
    function initSizeChart(wrapper) {
      if (!wrapper || wrapper.dataset.sizeChartInit === 'true') return;
      wrapper.dataset.sizeChartInit = 'true';

      var unitOptions = wrapper.querySelectorAll('.unit-option');
      var sizeValues  = wrapper.querySelectorAll('.size-value');
      if (!unitOptions.length || !sizeValues.length) return;

      var inCM = false;

      unitOptions.forEach(function (option) {
        option.addEventListener('click', function () {
          unitOptions.forEach(function (o) { o.classList.remove('active'); });
          this.classList.add('active');
          inCM = this.dataset.unit === 'cm';

          sizeValues.forEach(function (span) {
            var inches = parseFloat(span.getAttribute('data-inches'));
            if (!isNaN(inches)) {
              span.textContent = inCM ? (inches * 2.54).toFixed(1) : inches;
            }
          });

          var noteEm = wrapper.querySelector('.size-chart-note em');
          if (noteEm) {
            noteEm.textContent = inCM
              ? '*Measurements are in centimeters.'
              : '*Measurements are in inches.';
          }
        });
      });
    }

    function loadSizeChartIntoDrawer(container) {
      if (container.dataset.loaded === 'true') return;
      container.dataset.loaded = 'true';

      var url = container.dataset.sizeChartUrl;
      if (!url) return;

      fetch(url)
        .then(function (r) { return r.text(); })
        .then(function (html) {
          var doc    = new DOMParser().parseFromString(html, 'text/html');
          var chart  = doc.querySelector('.size-chart-wrapper');
          var styles = doc.querySelectorAll('style');

          if (!chart) {
            container.innerHTML = '<div class="size-chart-drawer-loading">Size chart not found.</div>';
            return;
          }

          // Bring along the section styles so the table renders correctly inside the drawer
          var styleHTML = '';
          styles.forEach(function (s) { styleHTML += s.outerHTML; });

          container.innerHTML = styleHTML + chart.outerHTML;
          initSizeChart(container.querySelector('.size-chart-wrapper'));
        })
        .catch(function () {
          container.innerHTML = '<div class="size-chart-drawer-loading">Unable to load size chart.</div>';
        });
    }

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[aria-controls]');
      if (!btn) return;

      var drawerId = btn.getAttribute('aria-controls');
      if (!drawerId || !drawerId.startsWith('size-chart-')) return;

      var drawer = document.getElementById(drawerId);
      if (!drawer) return;

      var container = drawer.querySelector('.size-chart-drawer-content');
      if (container) loadSizeChartIntoDrawer(container);
    });
  })();
</script>
